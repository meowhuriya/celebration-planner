# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Public site URL for QR codes and personalized invite links (e.g. https://your-celebration.app)
# If omitted or running on localhost, a local Wi-Fi notice will be shown on QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
